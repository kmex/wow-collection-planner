# Banco SQLite local (criado por `wow-plan init`)
WOW_PLAN_DB=./data/wow_planner.db

# Pasta raiz da instalação do WoW (onde ficam _retail_, _classic_, etc.)
# Windows: C:\Program Files (x86)\World of Warcraft
# macOS:   /Applications/World of Warcraft
WOW_PATH=C:\Program Files (x86)\World of Warcraft

# Pasta "flavor" do Forever. No cliente atual é _forever_ (no beta era _classic_beta_).
WOW_FLAVOR=_forever_

# Nome da pasta da conta em WTF/Account/<CONTA>/ (opcional: se vazio, o app procura sozinho)
WOW_ACCOUNT=

# Caminho direto do SavedVariables do ATT (opcional; tem prioridade sobre os campos acima)
# Ex.: C:\Program Files (x86)\World of Warcraft\_forever_\WTF\Account\MINHACONTA\SavedVariables\AllTheThings.lua
ATT_SAVEDVARIABLES_PATH=

# Mapeamento YAML de tabelas do ATT -> categorias do app (opcional; usa o padrão embutido)
ATT_MAPPING_PATH=

# Pasta com YAMLs de game data que sobrepõem os embutidos (preenchida por `wow-plan update-game-data`)
WOW_PLAN_DATA_DIR=./data/game_data
